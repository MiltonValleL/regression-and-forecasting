














import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

import statsmodels.api as sm


# import the dataset
insurance = pd.read_csv('../datasets/insurance.csv')
insurance.head()


# let's re-crate our model
features = ['age', 'bmi']

X = sm.add_constant(insurance[features])
y = insurance['charges']

model = sm.OLS(y, X).fit()

model.summary()


sns.scatterplot(x=model.predict(), y=model.resid)

plt.xlabel('Predictions', fontsize=15, fontweight='bold')
plt.ylabel('Residuals', fontsize=15, fontweight='bold')

sns.despine()

















features = ['age', 'bmi', 'children']

X = sm.add_constant(insurance[features])
y = insurance['charges']

model = sm.OLS(y, X).fit()

model.summary()











import sklearn as sk


sk.__version__


# Time to start calculation now with Scikit-Learn
from sklearn.metrics import mean_absolute_error as mae
from sklearn.metrics import root_mean_squared_error as rmse
from sklearn.metrics import r2_score as r2

results = pd.DataFrame({'MAE':mae(y, model.predict()),
                        'RMSE':rmse(y, model.predict()),
                        'R2':r2(y, model.predict())}, index=['USD']).round(4)

results








# Now we'll create three random features with no-correlation with the target.
rng = np.random.default_rng(12345)

insurance_rand = insurance.assign(
    new_rand_col1 = rng.random(len(insurance)),
    new_rand_col2 = rng.random(len(insurance)),
    new_rand_col3 = rng.random(len(insurance))
)

insurance_rand.head()


# Now well check the correlation with the new features and target
sns.heatmap(insurance_rand.corr(numeric_only=True),
            cmap='viridis_r', annot=True, fmt='.2f',
           )


# Now it's time to retrain the model with this new features...
col_rand = ['age', 'bmi', 'children', 
            'new_rand_col1', 'new_rand_col2', 'new_rand_col3']

X = sm.add_constant(insurance_rand[col_rand])
y = insurance_rand['charges']

model_rand = sm.OLS(y, X).fit()

print(model.summary(title='OLS Regression Results - Original Dataset'))
print('\n\n') 
print(model_rand.summary(title='OLS Regression Results - New Random Features'))









